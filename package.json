{
  "name": "clickit",
  "displayName": "Clickit — Git for Beginners",
  "description": "%description%",
  "version": "0.0.2",
  "publisher": "yeonbee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KimYeonBee/clickit.git"
  },
  "bugs": {
    "url": "https://github.com/KimYeonBee/clickit/issues"
  },
  "homepage": "https://github.com/KimYeonBee/clickit#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clickit.open",
        "title": "%command.open%",
        "category": "Clickit"
      },
      {
        "command": "clickit.newBranch",
        "title": "%command.newBranch%",
        "category": "Clickit"
      },
      {
        "command": "clickit.clone",
        "title": "%command.clone%",
        "category": "Clickit"
      },
      {
        "command": "clickit.publish",
        "title": "%command.publish%",
        "category": "Clickit"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clickit",
          "title": "Clickit",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "clickit": [
        {
          "id": "clickit.launcher",
          "name": "Clickit",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Clickit",
      "properties": {
        "clickit.warnOnMainBranch": {
          "type": "boolean",
          "default": true,
          "description": "%config.warnOnMainBranch%"
        },
        "clickit.skin": {
          "type": "string",
          "enum": [
            "vscode",
            "pixel"
          ],
          "enumDescriptions": [
            "%config.skin.vscode%",
            "%config.skin.pixel%"
          ],
          "default": "vscode",
          "description": "%config.skin%"
        },
        "clickit.language": {
          "type": "string",
          "enum": [
            "auto",
            "ko",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "한국어",
            "English"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "clickit.commitPrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "feat: ",
            "fix: ",
            "docs: ",
            "style: ",
            "refactor: ",
            "test: ",
            "chore: "
          ],
          "description": "%config.commitPrefixes%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "simple-git": "^3.22.0"
  }
}
